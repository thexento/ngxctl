# Generated by ngxctl
# Domain(s): {{ server_name }}

{% if force_https and ssl_enabled %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_name }};

    return 301 https://$host$request_uri;
}
{% endif %}

server {
    {% if ssl_enabled %}
    listen {{ listen_port }} ssl http2;
    listen [::]:{{ listen_port }} ssl http2;

    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    {% else %}
    listen {{ listen_port }};
    listen [::]:{{ listen_port }};
    {% endif %}

    server_name {{ server_name }};
    root {{ root_dir }};
    index {{ index_files }};

    location / {
        {% if is_spa %}
        # SPA client-side routing fallback
        try_files $uri $uri/ /{{ entrypoint | default('index.html') }};
        {% else %}
        try_files $uri $uri/ =404;
        {% endif %}
    }

    # Static media caching
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        log_not_found off;
        access_log off;
    }

    # Deny access to hidden dotfiles
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}